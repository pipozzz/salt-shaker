# Salt Shaker server (npm run dev:server / docker). Copy to .env for local development.

# salt-api and the service account the server uses for everyone (needs broad eauth perms)
SALT_API_URL=http://localhost:8000
SALT_API_USERNAME=shaker
SALT_API_PASSWORD=shaker
SALT_API_EAUTH=sharedsecret

# where the server is reached; cookies and origin checks are based on it
PUBLIC_URL=http://localhost:3100
PORT=3100
# the Vite dev server also calls the API
TRUSTED_ORIGINS=http://localhost:5173

# SQLite in DATA_DIR by default; set a postgres:// URL to use Postgres instead
DATA_DIR=./data
# DATABASE_URL=postgres://salt:salt@localhost:5432/salt_shaker

# optional: otherwise generated once and stored in DATA_DIR/auth-secret
# BETTER_AUTH_SECRET=
