# Copy to .env in this folder, fill it in and run: docker compose up -d
# Every setting here is passed to Salt Shaker; leave one out rather than empty.

# What runs, as compose files joined with ":"
#   compose.yml                                Salt Shaker alone, plain HTTP on LISTEN
#   compose.yml:compose.caddy.yml              + Caddy with automatic HTTPS
#   compose.yml:compose.traefik.yml            behind your Traefik
#   compose.yml:compose.caddy.yml:compose.postgres.yml   + Postgres instead of SQLite
COMPOSE_FILE=compose.yml

# The URL users open. With Caddy or Traefik: https://<the domain>
PUBLIC_URL=http://salt.example.internal:8080
# Where the plain setup listens on this host; 127.0.0.1:8080 for a reverse proxy on the same host
LISTEN=8080

# salt-api and the service account Salt Shaker uses (see "Prepare the master" in the docs)
SALT_API_URL=https://salt-master.internal:8000
SALT_API_USERNAME=salt-shaker
# with sharedsecret this is the master's shared secret; with pam, ldap or file the account's password
SALT_API_PASSWORD=change-me
SALT_API_EAUTH=sharedsecret

# pin a release instead of following latest, e.g. 1.20.0
SALT_SHAKER_VERSION=latest
TZ=UTC

# With compose.postgres.yml; generate with: openssl rand -hex 24
#POSTGRES_PASSWORD=

# With compose.traefik.yml: the host in PUBLIC_URL, and your Traefik's names if they differ
#DOMAIN=salt.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt

# Behind your own reverse proxy (nginx, a load balancer), so client IPs come from X-Forwarded-For
#TRUST_PROXY=1

# Optional single sign-on; redirect URI: <PUBLIC_URL>/api/auth/callback/oidc
#OIDC_ISSUER=https://sso.example.com/realms/main
#OIDC_NAME=SSO
#OIDC_CLIENT_ID=salt-shaker
#OIDC_CLIENT_SECRET=
#OIDC_ROLE_CLAIM=groups
#OIDC_ADMIN_GROUPS=salt-admins
#OIDC_OPERATOR_GROUPS=salt-operators
#OIDC_VIEWER_GROUPS=salt-viewers
#PASSWORD_LOGIN=admins

# Any other variable from the configuration reference works here too, e.g.
#METRICS_TOKEN=
#JOB_RETENTION_DAYS=90
