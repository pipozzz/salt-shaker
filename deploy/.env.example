# the name users open; DNS must point at this host for the certificate
DOMAIN=salt.example.com

# salt-api on the master, and the service account (see docs: Prepare the master)
SALT_API_URL=https://salt-master:8000
SALT_API_USERNAME=salt-shaker
SALT_API_EAUTH=sharedsecret
# the shared secret (openssl rand -base64 32), or the account's password with another eauth backend
SALT_API_PASSWORD=
