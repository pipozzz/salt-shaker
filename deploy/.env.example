# Copy to .env next to the compose files and fill in. Used by both
# docker-compose.yml (Postgres) and docker-compose.sqlite.yml (SQLite).

DOMAIN=salt.example.com

# salt-api and the service account Salt Shaker uses (see README: "The service account on the master")
SALT_API_URL=https://salt-master.internal:8000
SALT_API_USERNAME=salt-shaker
# with sharedsecret this is the master's shared secret; with pam, ldap or file the account's password
SALT_API_PASSWORD=change-me
SALT_API_EAUTH=sharedsecret

# generate with: openssl rand -base64 32
# Postgres only (docker-compose.yml)
POSTGRES_PASSWORD=
# required with Postgres; with SQLite, leave empty and it's generated into the data volume
BETTER_AUTH_SECRET=

TZ=UTC
# pin a release instead of following latest, e.g. 1.0.0
SALT_SHAKER_VERSION=latest

# Optional SSO (OIDC); redirect URI: https://$DOMAIN/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_NAME=SSO
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_GROUPS=salt-admins
OIDC_OPERATOR_GROUPS=salt-operators
OIDC_VIEWER_GROUPS=salt-viewers
PASSWORD_LOGIN=all
