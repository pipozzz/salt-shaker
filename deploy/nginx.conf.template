# Rendered by the nginx image's envsubst step (${SALT_API_URL}, ${NGINX_LOCAL_RESOLVERS}).
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Resolve the salt-api host per request rather than at start-up, so the UI still boots
    # (and recovers) when the master is down or not yet in DNS.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $salt_api ${SALT_API_URL};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /salt-api/ {
        rewrite ^/salt-api/(.*)$ /$1 break;
        proxy_pass $salt_api;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /events is a long-lived Server-Sent Events stream
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # cache headers via `expires`: an add_header here would drop the server-level headers above
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
